{
  "name": "@onemindos/tak-server-mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol (MCP) server for TAK Server integration with geospatial support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tak-server-mcp": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onemindos/tak-server-mcp.git"
  },
  "homepage": "https://github.com/onemindos/tak-server-mcp#readme",
  "bugs": {
    "url": "https://github.com/onemindos/tak-server-mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:mcp": "npm run build && node test-mcp.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:build": "docker build -t onemindos/tak-server-mcp:latest .",
    "docker:run": "docker run -it --rm onemindos/tak-server-mcp:latest",
    "demo": "npm run build && tsx src/demo/agent.ts"
  },
  "keywords": [
    "mcp",
    "tak",
    "tak-server",
    "freetakserver",
    "geospatial",
    "cot",
    "cursor-on-target",
    "model-context-protocol",
    "ai",
    "llm",
    "anthropic",
    "claude",
    "situational-awareness"
  ],
  "author": "OneMind OS",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@turf/turf": "^7.2.0",
    "axios": "^1.19.0",
    "chalk": "^5.4.1",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.3",
    "geojson": "^0.5.0",
    "h3-js": "^4.3.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.1.0",
    "mgrs": "^1.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prompts": "^2.4.2",
    "protobufjs": "^7.4.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "@types/prompts": "^2.4.9",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
